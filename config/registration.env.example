# Set these in the private backend environment before deploying/restarting the web role.
# Missing legal details, a missing token or known placeholder tokens close registration.
LECTURE_SIGNUP_TOKEN=
HEIST_IMPRINT_URL=https://emcl-ctf.iwr.uni-heidelberg.de/impressum
HEIST_PRIVACY_URL=https://emcl-ctf.iwr.uni-heidelberg.de/privacy-policy
# Operator-defined revision, e.g. the policy publication date; bump when text changes.
# HEIST_LEGAL_VERSION=your-policy-revision
HEIST_REGISTRATION_ENABLED=true

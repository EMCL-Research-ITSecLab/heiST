[Unit]
Description=Setup Bash Command Logging
After=network.target
Wants=network.target

[Service]
Type=oneshot
# Path to your setup script
ExecStart=/usr/local/sbin/heist-bash-logging
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

# Security hardening
User=root
Group=root

[Install]
WantedBy=multi-user.target